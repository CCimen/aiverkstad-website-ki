# Eneo Demo Tenant Creation - Environment Configuration (FOR setup_demo.py)
# Copy this file to .env and update with your actual values

# ===================================
# BACKEND CONNECTION
# ===================================

# Backend URL where Eneo is running
# Default: http://localhost:8123
ENEO_BACKEND_URL=http://localhost:8123

# Sysadmin API key for tenant creation
# REQUIRED: Get this from your Eneo backend configuration
# This is the key used for administrative operations
ENEO_SUPER_API_KEY=your-actual-sysadmin-api-key-here

# API key header name
# Default: X-API-Key (matches Eneo backend configuration)
ENEO_API_KEY_HEADER_NAME=X-API-Key

# ===================================
# DEMO CONFIGURATION
# ===================================

# Number of demo tenants to create
# Default: 20
DEMO_TENANT_COUNT=20

# Storage quota per tenant (in bytes)
# Default: 1073741824 (1GB)
DEMO_QUOTA_LIMIT=1073741824

# ===================================
# AI MODEL CONFIGURATION
# ===================================

# Completion model to enable for all demo tenants
# Default: gpt-4o-mini (cost-effective for demos)
DEMO_COMPLETION_MODEL=gpt-4o-mini

# Embedding model to enable for all demo tenants
# Default: text-embedding-ada-002
DEMO_EMBEDDING_MODEL=text-embedding-ada-002

# Transcription model to enable for all demo tenants
# Default: whisper-1
DEMO_TRANSCRIPTION_MODEL=whisper-1

# ===================================
# FRONTEND EMAIL CONFIGURATION (for signup flow)
# ===================================

# Resend API key for sending credentials via email
# Get this from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Email address to send from (must be verified domain)
# Example: demo@aiverkstad.se
RESEND_FROM_EMAIL=demo@yourdomain.se

# ===================================
# NOTES
# ===================================

# 1. The INTRIC_SUPER_API_KEY is the most critical setting
#    - This must match the sysadmin API key in your Eneo backend
#    - Without this, tenant creation will fail
#
# 2. Model names must exactly match the models available in your Eneo instance
#    - Use the API to check available models if unsure
#    - python setup_demo.py will list available models if any are missing
#
# 3. Backend must be running and accessible before running scripts
#    - Start with: cd eneo/backend && poetry run start
#
# 4. Email configuration is needed for the frontend signup flow
#    - Configure RESEND_API_KEY and RESEND_FROM_EMAIL
#    - Test email delivery before demo day
#
# 5. Quick setup command:
#    - python setup_demo.py
