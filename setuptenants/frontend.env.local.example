# Example environment variables for Eneo demo
# Copy this file to .env.local and update with your actual values

# Eneo Backend Configuration
ENEO_BACKEND_URL=http://localhost:8123
ENEO_SUPER_API_KEY=INTRIC_SUPER_API_KEY
ENEO_API_KEY_HEADER_NAME=X-API-Key
ENEO_PREDEFINED_OWNER_ROLE_ID=your-role-uuid-here

# Email Configuration (Resend)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=demo@aiverkstad.se
RESEND_RECIPIENTS=support@aiverkstad.se,admin@aiverkstad.se

# Demo Configuration
DEMO_MAX_TENANTS=20
DEMO_TENANT_PREFIX=demo-pool-